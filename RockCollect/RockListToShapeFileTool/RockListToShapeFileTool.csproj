<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>RockCollect</RootNamespace>
    <AssemblyName>RockListToShapeFile</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Rocklist\RockListToShapeFile.cs" Link="RockListToShapeFile.cs" />
    <Compile Include="..\RockDetector.cs" Link="RockDetector.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.Features" Version="2.2.0" />
    <PackageReference Include="NetTopologySuite.IO.Esri.Shapefile" Version="1.2.0" />
    <!-- Pinned to match RockCollect.csproj's packages.config exactly, since pack-release.sh
         copies both projects' output DLLs into the same release folder. -->
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

</Project>
